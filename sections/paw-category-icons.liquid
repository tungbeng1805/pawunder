<div class="paw-cat-icons" id="paw-cat-icons-{{ section.id }}">
  <div class="paw-cat-icons__inner">
    {%- if section.settings.heading != blank -%}
      <div class="paw-cat-icons__header">
        <h2 class="paw-cat-icons__heading">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="paw-cat-icons__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign item_tag = 'div'
        assign fallback_product = collections.all.products[forloop.index0]
        if block.settings.link != blank
          assign item_tag = 'a'
        endif
      -%}
      <{{ item_tag }}
        class="paw-cat-icons__item"
        {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
        {{ block.shopify_attributes }}
      >
        <span class="paw-cat-icons__icon-wrap" style="background-color: {{ section.settings.icon_bg }};">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 200
              | image_tag:
                class: 'paw-cat-icons__image',
                widths: '80, 120, 160, 200',
                sizes: '80px',
                loading: 'lazy',
                alt: block.settings.title
            }}
          {%- elsif fallback_product.featured_media != blank -%}
            {{
              fallback_product.featured_media
              | image_url: width: 800
              | image_tag:
                class: 'paw-cat-icons__image paw-cat-icons__image--product',
                widths: '180, 280, 400, 600, 800',
                sizes: '(max-width: 749px) 30vw, 220px',
                loading: 'lazy',
                alt: fallback_product.title
            }}
          {%- else -%}
            <span class="paw-cat-icons__svg" style="color: {{ section.settings.icon_color }};">
              {%- case block.settings.icon -%}
                {%- when 'shoes' -%}
                  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M10 38c6-2 12-8 18-8 4 0 7 2 10 5l8 8c2 2 5 3 8 2 3-1 5-4 5-7v-2c0-3-2-6-5-7l-14-6c-4-2-8-2-12 0L10 30v8z"/><path d="M10 38v8c0 2 2 4 4 4h8"/><path d="M22 28c2-6 8-10 14-10"/></svg>
                {%- when 'stairs' -%}
                  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 50h12V38h12V26h12V14h4"/><path d="M12 50V14"/></svg>
                {%- when 'collar' -%}
                  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><ellipse cx="32" cy="34" rx="18" ry="12"/><rect x="26" y="18" width="12" height="10" rx="2"/><circle cx="32" cy="34" r="3"/></svg>
                {%- when 'toy' -%}
                  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M18 28c-4 0-6 3-6 6s2 6 6 6c2 0 3-1 4-2l4-4 4 4c1 1 2 2 4 2 4 0 6-3 6-6s-2-6-6-6c-2 0-3 1-4 2l-4 4-4-4c-1-1-2-2-4-2z"/><path d="M38 28c4-4 10-4 14 0"/><path d="M12 28c4-4 10-4 14 0"/></svg>
                {%- when 'bed' -%}
                  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M10 40c0-10 10-18 22-18s22 8 22 18"/><path d="M8 42h48"/><path d="M14 42v6M50 42v6"/><ellipse cx="32" cy="30" rx="8" ry="5"/></svg>
                {%- when 'house' -%}
                  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M10 30 L32 12 L54 30 V52 H10 Z"/><path d="M26 52V38h12v14"/><circle cx="40" cy="28" r="3"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="32" cy="32" r="18"/><path d="M24 34c2 4 14 4 16 0"/><circle cx="26" cy="28" r="2"/><circle cx="38" cy="28" r="2"/></svg>
              {%- endcase -%}
            </span>
          {%- endif -%}
        </span>
        {%- if block.settings.title != blank -%}
          <span class="paw-cat-icons__title">{{ block.settings.title }}</span>
        {%- endif -%}
      </{{ item_tag }}>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .paw-cat-icons {
    width: 100%;
    padding: 28px var(--page-margin) 12px;
    background: #fff;
  }

  .paw-cat-icons__inner {
    width: 100%;
    max-width: var(--page-content-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 14px 16px;
  }

  .paw-cat-icons__header {
    grid-column: 1 / -1;
    text-align: center;
  }

  .paw-cat-icons__heading {
    margin: 0;
    color: #1a1a1a;
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .paw-cat-icons__subheading {
    margin: 7px 0 2px;
    color: #5d5d5d;
    font-size: 14px;
  }

  .paw-cat-icons__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: inherit;
  }

  .paw-cat-icons__icon-wrap {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: transform 0.2s ease;
  }

  .paw-cat-icons__item:hover .paw-cat-icons__icon-wrap {
    transform: translateY(-3px);
  }

  .paw-cat-icons__image {
    width: 70%;
    height: 70%;
    object-fit: contain;
  }

  .paw-cat-icons__image--product {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .paw-cat-icons__svg {
    width: 52%;
    height: 52%;
    display: flex;
  }

  .paw-cat-icons__svg svg {
    width: 100%;
    height: 100%;
  }

  .paw-cat-icons__title {
    font-size: 14px;
    font-weight: 600;
    color: #1a1a1a;
    text-align: center;
    line-height: 1.3;
  }

  @media screen and (max-width: 749px) {
    .paw-cat-icons {
      padding: 20px var(--page-margin) 8px;
    }

    .paw-cat-icons__inner {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px 12px;
    }

    .paw-cat-icons__icon-wrap {
      border-radius: 50%;
    }

    .paw-cat-icons__title {
      font-size: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Paw Category Icons",
  "tag": "section",
  "class": "paw-category-icons-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find their next favourite"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore essentials picked for every kind of pet."
    },
    {
      "type": "color",
      "id": "icon_bg",
      "label": "Icon background",
      "default": "#F5E6D3"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#1A1A1A"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Placeholder icon",
          "options": [
            { "value": "shoes", "label": "Dog Shoes" },
            { "value": "stairs", "label": "Dog Stairs" },
            { "value": "collar", "label": "Dog Collar" },
            { "value": "toy", "label": "Dog Toy" },
            { "value": "bed", "label": "Cat Bed" },
            { "value": "house", "label": "Pet House" },
            { "value": "paw", "label": "Paw" }
          ],
          "default": "paw"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom icon image",
          "info": "Optional. Replaces the placeholder icon."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Paw Category Icons",
      "blocks": [
        { "type": "category", "settings": { "title": "Dog Shoes", "icon": "shoes" } },
        { "type": "category", "settings": { "title": "Dog Stairs", "icon": "stairs" } },
        { "type": "category", "settings": { "title": "Dog Collar", "icon": "collar" } },
        { "type": "category", "settings": { "title": "Dog Toy", "icon": "toy" } },
        { "type": "category", "settings": { "title": "Cat Bed", "icon": "bed" } },
        { "type": "category", "settings": { "title": "Pet House", "icon": "house" } }
      ]
    }
  ]
}
{% endschema %}
