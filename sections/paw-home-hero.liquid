{%- liquid
  assign hero_image = section.settings.image
  assign hero_link = section.settings.link
  assign hero_alt = shop.name
  if hero_image != blank and hero_image.alt != blank
    assign hero_alt = hero_image.alt
  endif
-%}

<div class="paw-home-hero" id="paw-home-hero-{{ section.id }}">
  {%- if hero_link != blank -%}
    <a href="{{ hero_link }}" class="paw-home-hero__link"{% if section.settings.open_in_new_tab %} target="_blank" rel="noopener"{% endif %}>
  {%- endif -%}

  {%- if hero_image != blank -%}
    {{
      hero_image
      | image_url: width: 2400
      | image_tag:
        class: 'paw-home-hero__image',
        widths: '750, 1100, 1500, 2000, 2400',
        sizes: '100vw',
        loading: 'eager',
        alt: hero_alt
    }}
  {%- else -%}
    <img
      class="paw-home-hero__image"
      src="{{ 'paw-home-hero.jpg' | asset_url }}"
      alt="{{ hero_alt | escape }}"
      width="1920"
      height="1080"
      loading="eager"
    >
  {%- endif -%}

  <div class="paw-home-hero__content">
    {%- if section.settings.eyebrow != blank -%}<p>{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="paw-home-hero__text">{{ section.settings.text | escape }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}<span class="paw-home-hero__button">{{ section.settings.button_label | escape }}</span>{%- endif -%}
  </div>

  {%- if hero_link != blank -%}
    </a>
  {%- endif -%}
</div>

{% stylesheet %}
  .paw-home-hero {
    width: 100%;
    line-height: 0;
    background: #f39233;
    overflow: hidden;
    position: relative;
  }

  .paw-home-hero__link {
    display: block;
  }

  .paw-home-hero__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .paw-home-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(80, 37, 8, 0.57), rgba(80, 37, 8, 0.05) 62%);
    pointer-events: none;
  }

  .paw-home-hero__content {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: max(var(--page-margin), calc((100% - var(--page-content-width)) / 2));
    width: min(390px, 42vw);
    color: #fff;
    transform: translateY(-50%);
  }

  .paw-home-hero__content p {
    margin: 0 0 7px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .paw-home-hero__content h2 {
    margin: 0;
    font-size: clamp(34px, 4vw, 61px);
    line-height: 0.96;
    letter-spacing: -0.045em;
  }

  .paw-home-hero__text { margin-top: 13px; font-size: 16px; line-height: 1.45; }

  .paw-home-hero__button {
    display: inline-block;
    margin-top: 20px;
    padding: 11px 17px;
    border-radius: 999px;
    color: #fff;
    background: #f39233;
    font-size: 13px;
    font-weight: 800;
  }

  @media screen and (max-width: 749px) {
    .paw-home-hero__image { height: 430px; object-position: 58% center; }
    .paw-home-hero__content { left: var(--page-margin); width: min(285px, 70vw); }
    .paw-home-hero__content h2 { font-size: 37px; }
    .paw-home-hero__text { font-size: 14px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Paw Home Hero",
  "tag": "section",
  "class": "paw-home-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Upload your final hero banner from admin. Placeholder is used until then."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PawUnder picks" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything for happier paws" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Discover thoughtful essentials for every walk, nap and adventure." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop best sellers" },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open link in new tab",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Paw Home Hero"
    }
  ]
}
{% endschema %}
