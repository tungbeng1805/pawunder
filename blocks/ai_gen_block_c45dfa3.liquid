{% doc %}
  @prompt
    Generate a product customization form interface designed for a 'Custom Pet Pillow' product, based on the layout and structure of image_14.png. The overall style should be clean, modern, and light, presented within a dashed-line container.
    
    Section 1: Pet Photo Upload
    
    Header (Left-aligned, darker font): Replace current text with: "1. Upload Pet Photos (Preferred pose for pillow)"
    
    Subtext (Below header): Modify to: "Please provide clear, high-quality, front-facing photos for the best pillow outline and print results. We recommend multiple angles if possible."
    
    Upload Button: Maintain the style of image_14.png. Change the button text and status text to English.
    
    Button Text (Change from 'Chọn tệp'): [Choose Photos]
    
    Status Text (Change from 'Không có tệp nào được chọn'): (0 / 5 photos selected - max 5)
    
    Self-Correction: Using a photo-count indicator is better than a simple 'none selected' message.
    Section 2: Color & Extra Details
    
    Header: Replace current text with: "4. Pillow Back Color:"
    
    Input Field (Dropdown): Text options: [Classic White], [Soft Beige], [Deep Teal #194950], [Light Gray], [Pink].
    
    Section 3: Special Requests
    
    Header: Keep similar, slightly modify: "5. Special Requests / Design Notes:"
    
    Text Area (Same style as image_14.png): Update placeholder: Anything else we should know? (e.g., add a small heart icon, special cropping request).
    
    Final Detail:
    
    Color Theme: All headers, labels, borders, and text fields should adhere to a dark teal color scheme (example: #194950).
    
    Text Alignment: All headers must be left-aligned. Input fields and buttons should be neatly stacked and indented. The overall layout must be vertical and compact, just like image_14.png."
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-pet-customization-form-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.container_padding }}px;
    border: 2px dashed {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-pet-customization-form__section-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.section_spacing }}px;
  }

  .ai-pet-customization-form__section-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-pet-customization-form__header-{{ ai_gen_id }} {
    font-size: {{ block.settings.header_font_size }}px;
    font-weight: 600;
    color: {{ block.settings.header_color }};
    margin: 0 0 {{ block.settings.header_margin_bottom }}px 0;
    text-align: left;
  }

  .ai-pet-customization-form__subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_font_size }}px;
    color: {{ block.settings.subtext_color }};
    margin: 0 0 {{ block.settings.subtext_margin_bottom }}px 0;
    line-height: 1.5;
  }

  .ai-pet-customization-form__upload-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-pet-customization-form__upload-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: 1px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    width: fit-content;
  }

  .ai-pet-customization-form__upload-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    border-color: {{ block.settings.button_hover_border }};
  }

  .ai-pet-customization-form__upload-input-{{ ai_gen_id }} {
    display: none;
  }

  .ai-pet-customization-form__upload-status-{{ ai_gen_id }} {
    font-size: {{ block.settings.status_font_size }}px;
    color: {{ block.settings.status_color }};
  }

  .ai-pet-customization-form__select-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    font-size: {{ block.settings.input_font_size }}px;
    color: {{ block.settings.input_text_color }};
    background-color: {{ block.settings.input_background }};
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-pet-customization-form__select-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.input_hover_background }};
  }

  .ai-pet-customization-form__select-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.header_color }};
    outline-offset: 2px;
  }

  .ai-pet-customization-form__textarea-{{ ai_gen_id }} {
    width: 100%;
    min-height: {{ block.settings.textarea_height }}px;
    padding: 12px 16px;
    font-size: {{ block.settings.input_font_size }}px;
    color: {{ block.settings.input_text_color }};
    background-color: {{ block.settings.input_background }};
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    resize: vertical;
    font-family: inherit;
    transition: all 0.3s ease;
  }

  .ai-pet-customization-form__textarea-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.input_hover_background }};
  }

  .ai-pet-customization-form__textarea-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.header_color }};
    outline-offset: 2px;
  }

  .ai-pet-customization-form__textarea-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.placeholder_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-pet-customization-form-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<pet-customization-form-{{ ai_gen_id }}
  class="ai-pet-customization-form-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-pet-customization-form__section-{{ ai_gen_id }}">
    <h3 class="ai-pet-customization-form__header-{{ ai_gen_id }}">
      {{ block.settings.upload_header }}
    </h3>
    <p class="ai-pet-customization-form__subtext-{{ ai_gen_id }}">
      {{ block.settings.upload_subtext }}
    </p>
    <div class="ai-pet-customization-form__upload-wrapper-{{ ai_gen_id }}">
      <label
        for="ai-pet-photo-upload-{{ ai_gen_id }}"
        class="ai-pet-customization-form__upload-button-{{ ai_gen_id }}"
      >
        {{ block.settings.upload_button_text }}
      </label>
      <input
        type="file"
        id="ai-pet-photo-upload-{{ ai_gen_id }}"
        class="ai-pet-customization-form__upload-input-{{ ai_gen_id }}"
        accept="image/*"
        multiple
        aria-label="Upload pet photos"
      >
      <span
        class="ai-pet-customization-form__upload-status-{{ ai_gen_id }}"
        data-status-text
      >
        {{ block.settings.upload_status_default }}
      </span>
    </div>
  </div>

  <div class="ai-pet-customization-form__section-{{ ai_gen_id }}">
    <h3 class="ai-pet-customization-form__header-{{ ai_gen_id }}">
      {{ block.settings.color_header }}
    </h3>
    <select
      class="ai-pet-customization-form__select-{{ ai_gen_id }}"
      aria-label="Select pillow back color"
    >
      <option value="classic-white">{{ block.settings.color_option_1 }}</option>
      <option value="soft-beige">{{ block.settings.color_option_2 }}</option>
      <option value="deep-teal">{{ block.settings.color_option_3 }}</option>
      <option value="light-gray">{{ block.settings.color_option_4 }}</option>
      <option value="pink">{{ block.settings.color_option_5 }}</option>
    </select>
  </div>

  <div class="ai-pet-customization-form__section-{{ ai_gen_id }}">
    <h3 class="ai-pet-customization-form__header-{{ ai_gen_id }}">
      {{ block.settings.notes_header }}
    </h3>
    <textarea
      class="ai-pet-customization-form__textarea-{{ ai_gen_id }}"
      placeholder="{{ block.settings.notes_placeholder }}"
      aria-label="Special requests or design notes"
    ></textarea>
  </div>
</pet-customization-form-{{ ai_gen_id }}>

<script>
  (function() {
    class PetCustomizationForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.fileInput = this.querySelector('.ai-pet-customization-form__upload-input-{{ ai_gen_id }}');
        this.statusText = this.querySelector('[data-status-text]');
        this.maxFiles = 5;

        if (this.fileInput && this.statusText) {
          this.fileInput.addEventListener('change', this.handleFileChange.bind(this));
        }
      }

      handleFileChange(event) {
        const files = event.target.files;
        const fileCount = files.length;

        if (fileCount > this.maxFiles) {
          this.statusText.textContent = `(${this.maxFiles} / ${this.maxFiles} photos selected - max ${this.maxFiles})`;
          const dataTransfer = new DataTransfer();
          for (let i = 0; i < this.maxFiles; i++) {
            dataTransfer.items.add(files[i]);
          }
          this.fileInput.files = dataTransfer.files;
        } else if (fileCount > 0) {
          this.statusText.textContent = `(${fileCount} / ${this.maxFiles} photos selected - max ${this.maxFiles})`;
        } else {
          this.statusText.textContent = `(0 / ${this.maxFiles} photos selected - max ${this.maxFiles})`;
        }
      }
    }

    customElements.define('pet-customization-form-{{ ai_gen_id }}', PetCustomizationForm{{ ai_gen_id }});
  })();
</script>

