{% doc %}
  @prompt
    Generate a clean and modern product customization form interface for a 'Custom Pet Pillow' product, following the vertical layout and dashed-line border container style of the provided image.
    
    Upload Section
    
    Title: 'Upload Pet Photos (Max 3-5 images):' (Left-aligned, bold, dark grey/black font).
    
    Instruction text below title: 'Please provide clear, high-quality photos for the best pillow printing results.' (Small, lighter grey font).
    
    Upload Button: A neat horizontal input bar. The button text should be '[Choose Photos]' and the status text next to it should say 'No file chosen'.
    
    Special Requests Section
    
    Title: 'Special Requests (Optional):' (Left-aligned, bold, dark grey/black font, with comfortable vertical spacing below the upload section).
    
    Text Input Area: A large, rounded-corner rectangular text field. Inside, the placeholder text should be 'Anything else we should know? (e.g., specific cropping requests or design notes)'.
    
    Design & Theme Rules
    
    The overall layout must be vertical, minimalist, and compact, wrapped inside a light grey dashed-line border.
    
    All elements, labels, and text fields should align to the left.
    
    Text and borders should use a dark teal tone (#194950) to match the brand identity.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-pet-customization-form-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.container_padding }}px;
    border: {{ block.settings.border_width }}px dashed {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-pet-customization-form__section-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.section_spacing }}px;
  }

  .ai-pet-customization-form__section-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-pet-customization-form__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: {{ block.settings.title_font_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    text-align: left;
  }

  .ai-pet-customization-form__instruction-{{ ai_gen_id }} {
    font-size: {{ block.settings.instruction_font_size }}px;
    color: {{ block.settings.instruction_color }};
    margin: 0 0 {{ block.settings.instruction_spacing }}px 0;
    line-height: 1.5;
    text-align: left;
  }

  .ai-pet-customization-form__upload-wrapper-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-pet-customization-form__upload-input-{{ ai_gen_id }} {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .ai-pet-customization-form__upload-button-{{ ai_gen_id }} {
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .ai-pet-customization-form__upload-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-pet-customization-form__upload-status-{{ ai_gen_id }} {
    font-size: {{ block.settings.status_font_size }}px;
    color: {{ block.settings.status_color }};
  }

  .ai-pet-customization-form__textarea-{{ ai_gen_id }} {
    width: 100%;
    min-height: {{ block.settings.textarea_height }}px;
    padding: {{ block.settings.textarea_padding }}px;
    border: {{ block.settings.textarea_border_width }}px solid {{ block.settings.textarea_border_color }};
    border-radius: {{ block.settings.textarea_border_radius }}px;
    font-size: {{ block.settings.textarea_font_size }}px;
    color: {{ block.settings.textarea_text_color }};
    background-color: {{ block.settings.textarea_background }};
    resize: vertical;
    font-family: inherit;
    line-height: 1.5;
  }

  .ai-pet-customization-form__textarea-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.placeholder_color }};
  }

  .ai-pet-customization-form__textarea-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.textarea_focus_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-pet-customization-form-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-pet-customization-form__upload-wrapper-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: flex-start;
    }
  }
{% endstyle %}

<pet-customization-form-{{ ai_gen_id }}
  class="ai-pet-customization-form-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-pet-customization-form__section-{{ ai_gen_id }}">
    <h3 class="ai-pet-customization-form__title-{{ ai_gen_id }}">
      {{ block.settings.upload_title }}
    </h3>
    
    {% if block.settings.upload_instruction != blank %}
      <p class="ai-pet-customization-form__instruction-{{ ai_gen_id }}">
        {{ block.settings.upload_instruction }}
      </p>
    {% endif %}

    <div class="ai-pet-customization-form__upload-wrapper-{{ ai_gen_id }}">
      <input
        type="file"
        id="ai-pet-upload-{{ ai_gen_id }}"
        class="ai-pet-customization-form__upload-input-{{ ai_gen_id }}"
        accept="image/*"
        multiple
        aria-label="Upload pet photos"
      >
      <label
        for="ai-pet-upload-{{ ai_gen_id }}"
        class="ai-pet-customization-form__upload-button-{{ ai_gen_id }}"
      >
        {{ block.settings.upload_button_text }}
      </label>
      <span
        class="ai-pet-customization-form__upload-status-{{ ai_gen_id }}"
        data-status-text
      >
        {{ block.settings.no_file_text }}
      </span>
    </div>
  </div>

  <div class="ai-pet-customization-form__section-{{ ai_gen_id }}">
    <h3 class="ai-pet-customization-form__title-{{ ai_gen_id }}">
      {{ block.settings.requests_title }}
    </h3>
    
    <textarea
      class="ai-pet-customization-form__textarea-{{ ai_gen_id }}"
      placeholder="{{ block.settings.textarea_placeholder }}"
      aria-label="Special requests"
      rows="5"
    ></textarea>
  </div>
</pet-customization-form-{{ ai_gen_id }}>

<script>
  (function() {
    class PetCustomizationForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.fileInput = this.querySelector('.ai-pet-customization-form__upload-input-{{ ai_gen_id }}');
        this.statusText = this.querySelector('[data-status-text]');
        
        if (this.fileInput && this.statusText) {
          this.fileInput.addEventListener('change', this.handleFileChange.bind(this));
        }
      }

      handleFileChange(event) {
        const files = event.target.files;
        
        if (files.length === 0) {
          this.statusText.textContent = '{{ block.settings.no_file_text }}';
        } else if (files.length === 1) {
          this.statusText.textContent = files[0].name;
        } else {
          this.statusText.textContent = files.length + ' files selected';
        }
      }
    }

    customElements.define('pet-customization-form-{{ ai_gen_id }}', PetCustomizationForm{{ ai_gen_id }});
  })();
</script>

