{% doc %}
  @prompt
    create for me a brand session with multiple columns to insert partner logos across the screen, compatible with both mobile and computer, editable session background color, customizable session width and height, session logos can move from right to left, above the logo insertion row there is an editable headline, the background of the logo insertion boxes can be adjusted in color, the boxes have no borders.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-brand-partners-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.section_background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-brand-partners-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.section_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-brand-partners-heading-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-brand-partners-carousel-wrapper-{{ ai_gen_id }} {
    overflow: hidden;
    position: relative;
  }

  .ai-brand-partners-carousel-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.logo_gap }}px;
    {% if block.settings.enable_scroll %}
      animation: ai-brand-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    {% endif %}
  }

  {% if block.settings.enable_scroll %}
    .ai-brand-partners-carousel-{{ ai_gen_id }}:hover {
      animation-play-state: paused;
    }

    @keyframes ai-brand-scroll-{{ ai_gen_id }} {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(-50%);
      }
    }
  {% endif %}

  .ai-brand-partners-logo-item-{{ ai_gen_id }} {
    flex: 0 0 auto;
    width: {{ block.settings.logo_width }}px;
    height: {{ block.settings.logo_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.logo_background_color }};
    padding: {{ block.settings.logo_padding }}px;
  }

  .ai-brand-partners-logo-item-{{ ai_gen_id }} img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .ai-brand-partners-logo-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-brand-partners-logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-brand-partners-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-brand-partners-logo-item-{{ ai_gen_id }} {
      width: {{ block.settings.logo_width_mobile }}px;
      height: {{ block.settings.logo_height_mobile }}px;
    }
  }
{% endstyle %}

<brand-partners-{{ ai_gen_id }} class="ai-brand-partners-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-brand-partners-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-brand-partners-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-brand-partners-carousel-wrapper-{{ ai_gen_id }}">
      <div class="ai-brand-partners-carousel-{{ ai_gen_id }}">
        {% for i in (1..12) %}
          {% liquid
            assign logo_key = 'logo_' | append: i
            assign logo = block.settings[logo_key]
          %}
          
          <div class="ai-brand-partners-logo-item-{{ ai_gen_id }}">
            {% if logo != blank %}
              <img
                src="{{ logo | image_url: width: 400 }}"
                alt="{{ logo.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.logo_width }}"
                height="{{ block.settings.logo_height }}"
              >
            {% else %}
              <div class="ai-brand-partners-logo-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        {% endfor %}

        {% if block.settings.enable_scroll %}
          {% for i in (1..12) %}
            {% liquid
              assign logo_key = 'logo_' | append: i
              assign logo = block.settings[logo_key]
            %}
            
            <div class="ai-brand-partners-logo-item-{{ ai_gen_id }}">
              {% if logo != blank %}
                <img
                  src="{{ logo | image_url: width: 400 }}"
                  alt="{{ logo.alt | escape }}"
                  loading="lazy"
                  width="{{ block.settings.logo_width }}"
                  height="{{ block.settings.logo_height }}"
                >
              {% else %}
                <div class="ai-brand-partners-logo-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</brand-partners-{{ ai_gen_id }}>

<script>
  (function() {
    class BrandPartners{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.carousel = this.querySelector('.ai-brand-partners-carousel-{{ ai_gen_id }}');
        this.adjustCarouselForMobile();
        window.addEventListener('resize', () => this.adjustCarouselForMobile());
      }

      adjustCarouselForMobile() {
        if (!this.carousel) return;
        
        const isMobile = window.innerWidth < 750;
        if (isMobile) {
          this.carousel.style.justifyContent = 'flex-start';
        } else {
          this.carousel.style.justifyContent = '';
        }
      }
    }

    customElements.define('brand-partners-{{ ai_gen_id }}', BrandPartners{{ ai_gen_id }});
  })();
</script>

