{% doc %}
  @prompt
    Create a custom footer with a dark navy background (#1a2433). The layout should have 4 columns. Column 1: Include the PawUnder logo, followed by contact details (Address, Email, Phone/WhatsApp) in white/light gray text. Column 2 (Header: ABOUT US): Links for Our Story, Wholesale Program, Reseller Program. Column 3 (Header: HELP CENTER): Links for Contact Us, Size Charts, Track Order, FAQs. Column 4 (Header: LEGAL & POLICIES): Links for Replacement & Refund Policy, Shipping and Delivery, Terms of Service, Privacy Policy. Ensure all headers are uppercase and bold. Below the columns, add a thin horizontal divider line, followed by a centered copyright text '© 2026 PawUnder. All Rights Reserved.' Remove all payment method icons and ensure no extra vertical white space at the bottom.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 0 0 0;
    width: 100%;
  }

  .ai-footer-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.horizontal_padding }}px;
  }

  .ai-footer-columns-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.column_gap }}px;
    margin-bottom: {{ block.settings.divider_spacing }}px;
  }

  .ai-footer-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.item_spacing }}px;
  }

  .ai-footer-logo-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.logo_spacing }}px;
  }

  .ai-footer-logo-{{ ai_gen_id }} img {
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
    display: block;
  }

  .ai-footer-contact-item-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  .ai-footer-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
  }

  .ai-footer-link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    font-size: {{ block.settings.text_size }}px;
    text-decoration: none;
    transition: color 0.3s ease;
    line-height: 1.6;
  }

  .ai-footer-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-footer-divider-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.divider_height }}px;
    background-color: {{ block.settings.divider_color }};
    margin: 0 0 {{ block.settings.divider_spacing }}px 0;
  }

  .ai-footer-copyright-{{ ai_gen_id }} {
    text-align: center;
    color: {{ block.settings.copyright_color }};
    font-size: {{ block.settings.copyright_size }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-footer-columns-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.column_gap_mobile }}px;
    }

    .ai-footer-column-{{ ai_gen_id }}:first-child {
      grid-column: 1 / -1;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-footer-columns-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-footer-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px 0 0 0;
    }

    .ai-footer-copyright-{{ ai_gen_id }} {
      padding-bottom: {{ block.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

<footer-block-{{ ai_gen_id }} class="ai-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-container-{{ ai_gen_id }}">
    <div class="ai-footer-columns-{{ ai_gen_id }}">
      <div class="ai-footer-column-{{ ai_gen_id }}">
        {% if block.settings.logo != blank %}
          <div class="ai-footer-logo-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.logo | image_url: width: 400 }}"
              alt="{{ shop.name }}"
              width="{{ block.settings.logo_width }}"
              height="auto"
              loading="lazy"
            >
          </div>
        {% endif %}

        {% if block.settings.address != blank %}
          <p class="ai-footer-contact-item-{{ ai_gen_id }}">{{ block.settings.address }}</p>
        {% endif %}

        {% if block.settings.email != blank %}
          <p class="ai-footer-contact-item-{{ ai_gen_id }}">{{ block.settings.email }}</p>
        {% endif %}

        {% if block.settings.phone != blank %}
          <p class="ai-footer-contact-item-{{ ai_gen_id }}">{{ block.settings.phone }}</p>
        {% endif %}
      </div>

      <div class="ai-footer-column-{{ ai_gen_id }}">
        <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.column_2_heading }}</h3>
        {% if block.settings.link_2_1_text != blank and block.settings.link_2_1_url != blank %}
          <a href="{{ block.settings.link_2_1_url }}" class="ai-footer-link-{{ ai_gen_id }}">
            {{ block.settings.link_2_1_text }}
          </a>
        {% endif %}
        {% if block.settings.link_2_2_text != blank and block.settings.link_2_2_url != blank %}
          <a href="{{ block.settings.link_2_2_url }}" class="ai-footer-link-{{ ai_gen_id }}">
            {{ block.settings.link_2_2_text }}
          </a>
        {% endif %}
        {% if block.settings.link_2_3_text != blank and block.settings.link_2_3_url != blank %}
          <a href="{{ block.settings.link_2_3_url }}" class="ai-footer-link-{{ ai_gen_id }}">
            {{ block.settings.link_2_3_text }}
          </a>
        {% endif %}
      </div>

      <div class="ai-footer-column-{{ ai_gen_id }}">
        <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.column_3_heading }}</h3>
        {% if block.settings.link_3_1_text != blank and block.settings.link_3_1_url != blank %}
          <a href="{{ block.settings.link_3_1_url }}" class="ai-footer-link-{{ ai_gen_id }}">
            {{ block.settings.link_3_1_text }}
          </a>
        {% endif %}
        {% if block.settings.link_3_2_text != blank and block.settings.link_3_2_url != blank %}
          <a href="{{ block.settings.link_3_2_url }}" class="ai-footer-link-{{ ai_gen_id }}">
            {{ block.settings.link_3_2_text }}
          </a>
        {% endif %}
        {% if block.settings.link_3_3_text != blank and block.settings.link_3_3_url != blank %}
          <a href="{{ block.settings.link_3_3_url }}" class="ai-footer-link-{{ ai_gen_id }}">
            {{ block.settings.link_3_3_text }}
          </a>
        {% endif %}
        {% if block.settings.link_3_4_text != blank and block.settings.link_3_4_url != blank %}
          <a href="{{ block.settings.link_3_4_url }}" class="ai-footer-link-{{ ai_gen_id }}">
            {{ block.settings.link_3_4_text }}
          </a>
        {% endif %}
      </div>

      <div class="ai-footer-column-{{ ai_gen_id }}">
        <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.column_4_heading }}</h3>
        {% if block.settings.link_4_1_text != blank and block.settings.link_4_1_url != blank %}
          <a href="{{ block.settings.link_4_1_url }}" class="ai-footer-link-{{ ai_gen_id }}">
            {{ block.settings.link_4_1_text }}
          </a>
        {% endif %}
        {% if block.settings.link_4_2_text != blank and block.settings.link_4_2_url != blank %}
          <a href="{{ block.settings.link_4_2_url }}" class="ai-footer-link-{{ ai_gen_id }}">
            {{ block.settings.link_4_2_text }}
          </a>
        {% endif %}
        {% if block.settings.link_4_3_text != blank and block.settings.link_4_3_url != blank %}
          <a href="{{ block.settings.link_4_3_url }}" class="ai-footer-link-{{ ai_gen_id }}">
            {{ block.settings.link_4_3_text }}
          </a>
        {% endif %}
        {% if block.settings.link_4_4_text != blank and block.settings.link_4_4_url != blank %}
          <a href="{{ block.settings.link_4_4_url }}" class="ai-footer-link-{{ ai_gen_id }}">
            {{ block.settings.link_4_4_text }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="ai-footer-divider-{{ ai_gen_id }}"></div>

    <p class="ai-footer-copyright-{{ ai_gen_id }}">{{ block.settings.copyright_text }}</p>
  </div>
</footer-block-{{ ai_gen_id }}>

<script>
  (function() {
    class FooterBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('footer-block-{{ ai_gen_id }}', FooterBlock{{ ai_gen_id }});
  })();
</script>

