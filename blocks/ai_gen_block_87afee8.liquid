{% doc %}
  @prompt
    create for me a brand session with multiple columns to insert partner logos across the screen, compatible with both mobile and computer, editable session background color, customizable session width and height, session logos can move from right to left, above the logo insertion row there is an editable headline, the background of the logo insertion boxes can be adjusted in color, the boxes have no borders.
    The total of numbers brands is 6. They are loopy
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-brand-showcase-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.section_background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-brand-showcase-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.section_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-brand-showcase-heading-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-brand-showcase-wrapper-{{ ai_gen_id }} {
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .ai-brand-showcase-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.logo_gap }}px;
    width: fit-content;
  }

  .ai-brand-showcase-track-{{ ai_gen_id }}.scrolling {
    animation: ai-brand-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
  }

  .ai-brand-showcase-item-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.logo_width }}px;
    height: {{ block.settings.logo_height }}px;
    background-color: {{ block.settings.logo_background_color }};
    border-radius: {{ block.settings.logo_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.logo_padding }}px;
  }

  .ai-brand-showcase-item-{{ ai_gen_id }} img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .ai-brand-showcase-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    font-size: 12px;
  }

  @keyframes ai-brand-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-{{ block.settings.logo_width }}px * 6 - {{ block.settings.logo_gap }}px * 6));
    }
  }

  @media screen and (max-width: 749px) {
    .ai-brand-showcase-item-{{ ai_gen_id }} {
      width: {{ block.settings.logo_width_mobile }}px;
      height: {{ block.settings.logo_height_mobile }}px;
    }

    .ai-brand-showcase-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    @keyframes ai-brand-scroll-{{ ai_gen_id }} {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(calc(-{{ block.settings.logo_width_mobile }}px * 6 - {{ block.settings.logo_gap }}px * 6));
      }
    }
  }
{% endstyle %}

<brand-showcase-{{ ai_gen_id }} class="ai-brand-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-brand-showcase-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-brand-showcase-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-brand-showcase-wrapper-{{ ai_gen_id }}">
      <div class="ai-brand-showcase-track-{{ ai_gen_id }} {% if block.settings.enable_scroll %}scrolling{% endif %}">
        {% for i in (1..6) %}
          {% assign logo_key = 'logo_' | append: i %}
          {% assign logo = block.settings[logo_key] %}
          
          <div class="ai-brand-showcase-item-{{ ai_gen_id }}">
            {% if logo != blank %}
              <img
                src="{{ logo | image_url: width: 400 }}"
                alt="{{ logo.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.logo_width }}"
                height="{{ block.settings.logo_height }}"
              >
            {% else %}
              <div class="ai-brand-showcase-placeholder-{{ ai_gen_id }}">
                Logo {{ i }}
              </div>
            {% endif %}
          </div>
        {% endfor %}

        {% if block.settings.enable_scroll %}
          {% for i in (1..6) %}
            {% assign logo_key = 'logo_' | append: i %}
            {% assign logo = block.settings[logo_key] %}
            
            <div class="ai-brand-showcase-item-{{ ai_gen_id }}">
              {% if logo != blank %}
                <img
                  src="{{ logo | image_url: width: 400 }}"
                  alt="{{ logo.alt | escape }}"
                  loading="lazy"
                  width="{{ block.settings.logo_width }}"
                  height="{{ block.settings.logo_height }}"
                >
              {% else %}
                <div class="ai-brand-showcase-placeholder-{{ ai_gen_id }}">
                  Logo {{ i }}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</brand-showcase-{{ ai_gen_id }}>

<script>
  (function() {
    class BrandShowcase{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-brand-showcase-track-{{ ai_gen_id }}');
        
        if (this.track && this.track.classList.contains('scrolling')) {
          this.track.addEventListener('mouseenter', () => {
            this.track.style.animationPlayState = 'paused';
          });

          this.track.addEventListener('mouseleave', () => {
            this.track.style.animationPlayState = 'running';
          });
        }
      }
    }

    customElements.define('brand-showcase-{{ ai_gen_id }}', BrandShowcase{{ ai_gen_id }});
  })();
</script>

