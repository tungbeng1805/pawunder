{%- comment -%}
  Visual free-gift offer. Does not add products to the cart or change prices.
  Accepts: scope_id, stts (block/section settings)
{%- endcomment -%}
{%- liquid
  assign fgo_id = scope_id
  assign fgo_heading_size = stts.heading_size | default: 18
  assign fgo_heading_weight = stts.heading_weight | default: '700'
  assign fgo_pad_top = stts.padding_top | default: 0
  assign fgo_pad_bottom = stts.padding_bottom | default: 0
  assign fgo_gap = stts.card_gap | default: 8
  assign fgo_radius = stts.border_radius | default: 8
  assign fgo_dash = stts.dash_color | default: '#F0A030'
  assign fgo_title_size = stts.title_size | default: 13
  assign fgo_title_color = stts.title_color | default: '#222222'
  assign fgo_bg = stts.background | default: 'transparent'
  assign fgo_show_heading = true
  if stts.show_heading == false
    assign fgo_show_heading = false
  endif
-%}
{%- style -%}
  #fgo-{{ fgo_id }} {
    --fgo-heading-size: {{ fgo_heading_size }}px;
    --fgo-heading-weight: {{ fgo_heading_weight }};
    --fgo-gap: {{ fgo_gap }}px;
    --fgo-radius: {{ fgo_radius }}px;
    --fgo-dash: {{ fgo_dash }};
    --fgo-title-size: {{ fgo_title_size }}px;
    --fgo-title-color: {{ fgo_title_color }};
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    container-type: inline-size;
    container-name: fgo;
    padding: {{ fgo_pad_top }}px 0 {{ fgo_pad_bottom }}px;
    background: {{ fgo_bg }};
    color: {{ fgo_title_color }};
  }
  #fgo-{{ fgo_id }} *,
  #fgo-{{ fgo_id }} *::before,
  #fgo-{{ fgo_id }} *::after {
    box-sizing: border-box;
  }
  #fgo-{{ fgo_id }} .fgo__heading {
    margin: 0 0 10px;
    padding: 0;
    text-align: center;
    font-family: inherit;
    font-size: var(--fgo-heading-size);
    font-weight: var(--fgo-heading-weight);
    line-height: 1.3;
    color: #111111;
  }
  #fgo-{{ fgo_id }} .fgo__track {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 34px minmax(0, 2fr);
    align-items: stretch;
    gap: var(--fgo-gap);
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
  }
  #fgo-{{ fgo_id }} .fgo__combo {
    min-width: 0;
    padding: 12px 10px 10px;
    border: 1px solid #ffe0b2;
    border-radius: calc(var(--fgo-radius) + 8px);
    background: #fff7e9;
  }
  #fgo-{{ fgo_id }} .fgo__combo-label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin: 0 0 10px;
    color: #d94b00;
    font-family: inherit;
    font-size: 13px;
    font-weight: 800;
    line-height: 1.3;
    text-align: center;
  }
  #fgo-{{ fgo_id }} .fgo__combo-label::before,
  #fgo-{{ fgo_id }} .fgo__combo-label::after {
    content: '';
    flex: 1 1 0;
    max-width: 44px;
    height: 1px;
    background: #ffad60;
  }
  #fgo-{{ fgo_id }} .fgo__combo-label > span {
    padding: 4px 9px;
    border: 1px solid #ffbb78;
    border-radius: 999px;
    white-space: nowrap;
  }
  #fgo-{{ fgo_id }} .fgo__combo-items {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    min-width: 0;
  }
  #fgo-{{ fgo_id }} .fgo__combo--pair .fgo__combo-items {
    grid-template-columns: minmax(0, 1fr) 26px minmax(0, 1fr);
    gap: 4px;
  }
  #fgo-{{ fgo_id }} .fgo__operator {
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: center;
    width: 34px;
    height: 34px;
    border: 2px solid #ff7900;
    border-radius: 50%;
    background: #fff;
    color: #e85c00;
    font-family: inherit;
    font-size: 13px;
    font-weight: 800;
    line-height: 1;
  }
  #fgo-{{ fgo_id }} .fgo__operator--plus {
    width: 26px;
    height: 26px;
    background: #ff7900;
    color: #fff;
    font-size: 23px;
  }
  #fgo-{{ fgo_id }} .fgo__card {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    min-width: 0;
    text-align: center;
    color: inherit;
  }
  #fgo-{{ fgo_id }} .fgo__media {
    position: relative;
    width: 100%;
    min-width: 0;
    padding-top: 10px;
  }
  #fgo-{{ fgo_id }} .fgo__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--fgo-radius);
    background: #fff;
  }
  #fgo-{{ fgo_id }} .fgo__frame.is-dashed::before {
    content: "";
    position: absolute;
    z-index: 1;
    inset: 0;
    border: 1.5px dashed var(--fgo-dash);
    border-radius: inherit;
    pointer-events: none;
  }
  #fgo-{{ fgo_id }} .fgo__img-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    background: #f4f4f4;
  }
  #fgo-{{ fgo_id }} .fgo__frame.is-dashed .fgo__img-wrap {
    inset: 4px;
    border-radius: max(0px, calc(var(--fgo-radius) - 4px));
  }
  #fgo-{{ fgo_id }} .fgo__img,
  #fgo-{{ fgo_id }} .fgo__img-wrap svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  #fgo-{{ fgo_id }} .fgo__badge {
    position: absolute;
    z-index: 2;
    top: 10px;
    left: 50%;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    max-width: calc(100% - 2px);
    padding: 2px 5px;
    border-radius: 3px;
    font-family: inherit;
    font-size: 11px;
    line-height: 1.15;
    white-space: nowrap;
    pointer-events: none;
    background: #FFE14D;
    color: #111111;
  }
  #fgo-{{ fgo_id }} .fgo__badge-price {
    font-size: 0.9em;
    font-weight: 500;
    text-decoration: line-through;
  }
  #fgo-{{ fgo_id }} .fgo__badge-free {
    font-weight: 800;
  }
  #fgo-{{ fgo_id }} .fgo__title {
    margin: 6px 0 0;
    padding: 0;
    text-align: center;
    font-family: inherit;
    font-size: var(--fgo-title-size);
    font-weight: 500;
    line-height: 1.35;
    color: var(--fgo-title-color);
    overflow-wrap: break-word;
  }
  @container fgo (max-width: 520px) {
    #fgo-{{ fgo_id }} .fgo__heading {
      margin-bottom: 8px;
      font-size: min(var(--fgo-heading-size), 16px);
    }
    #fgo-{{ fgo_id }} .fgo__media {
      padding-top: 8px;
    }
    #fgo-{{ fgo_id }} .fgo__track {
      grid-template-columns: minmax(0, 1fr) 26px minmax(0, 2fr);
      gap: min(var(--fgo-gap), 4px);
    }
    #fgo-{{ fgo_id }} .fgo__combo {
      padding: 8px 5px 7px;
      border-radius: var(--fgo-radius);
    }
    #fgo-{{ fgo_id }} .fgo__combo-label {
      gap: 3px;
      margin-bottom: 8px;
      font-size: 10px;
    }
    #fgo-{{ fgo_id }} .fgo__combo-label > span {
      padding: 3px 5px;
    }
    #fgo-{{ fgo_id }} .fgo__combo--pair .fgo__combo-items {
      grid-template-columns: minmax(0, 1fr) 18px minmax(0, 1fr);
      gap: 2px;
    }
    #fgo-{{ fgo_id }} .fgo__operator {
      width: 26px;
      height: 26px;
      font-size: 10px;
    }
    #fgo-{{ fgo_id }} .fgo__operator--plus {
      width: 18px;
      height: 18px;
      border-width: 1px;
      font-size: 17px;
    }
    #fgo-{{ fgo_id }} .fgo__title {
      margin-top: 4px;
      font-size: min(var(--fgo-title-size), 11px);
    }
    #fgo-{{ fgo_id }} .fgo__badge {
      top: 8px;
      gap: 2px;
      padding: 1px 2px;
      font-size: 9px;
    }
    #fgo-{{ fgo_id }} .fgo__frame.is-dashed .fgo__img-wrap {
      inset: 3px;
    }
  }
  @container fgo (max-width: 360px) {
    #fgo-{{ fgo_id }} .fgo__heading {
      font-size: min(var(--fgo-heading-size), 14px);
    }
    #fgo-{{ fgo_id }} .fgo__title {
      font-size: 11px;
    }
    #fgo-{{ fgo_id }} .fgo__badge {
      font-size: 8px;
    }
  }
{%- endstyle -%}
<div id="fgo-{{ fgo_id }}" class="fgo">
  {%- if fgo_show_heading and stts.heading != blank -%}
    <p class="fgo__heading">{{ stts.heading | escape }}</p>
  {%- endif -%}
  <div class="fgo__track">
    {%- for combo in (1..2) -%}
      {%- liquid
        assign first_card = 1
        assign last_card = 1
        if combo == 2
          assign first_card = 2
          assign last_card = 3
        endif
      -%}
      {%- if combo == 2 -%}
        <span class="fgo__operator">OR</span>
      {%- endif -%}
      <div class="fgo__combo{% if combo == 2 %} fgo__combo--pair{% endif %}" role="group" aria-label="Combo {{ combo }}">
        <p class="fgo__combo-label"><span><span aria-hidden="true">🎁</span> COMBO {{ combo }}</span></p>
        <div class="fgo__combo-items">
          {%- for i in (first_card..last_card) -%}
      {%- if i == 3 -%}
        <span class="fgo__operator fgo__operator--plus" role="img" aria-label="Plus">+</span>
      {%- endif -%}
      {%- liquid
        case i
          when 1
            assign card_image = stts.image_1
            assign card_title = stts.title_1
            assign card_price = stts.price_1
            assign card_show_badge = stts.show_badge_1
            assign card_show_border = stts.show_border_1
            assign placeholder_name = 'image'
          when 2
            assign card_image = stts.image_2
            assign card_title = stts.title_2
            assign card_price = stts.price_2
            assign card_show_badge = stts.show_badge_2
            assign card_show_border = stts.show_border_2
            assign placeholder_name = 'product-1'
          else
            assign card_image = stts.image_3
            assign card_title = stts.title_3
            assign card_price = stts.price_3
            assign card_show_badge = stts.show_badge_3
            assign card_show_border = stts.show_border_3
            assign placeholder_name = 'product-2'
        endcase
        assign free_text = stts.free_text | default: 'FREE'
        assign show_badge = false
        if card_show_badge and card_price != blank
          assign show_badge = true
        endif
      -%}
      <div class="fgo__card">
        <div class="fgo__media">
          {%- if show_badge -%}
            <span class="fgo__badge">
              <span class="fgo__badge-price">{{ card_price | escape }}</span>
              <span class="fgo__badge-free">{{ free_text | escape }}</span>
            </span>
          {%- endif -%}
          <div class="fgo__frame{% if card_show_border %} is-dashed{% endif %}">
            <div class="fgo__img-wrap">
              {%- if card_image != blank -%}
                {%- assign img_alt = card_image.alt | default: card_title -%}
                {{
                  card_image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    widths: '120, 180, 240, 360, 480, 600',
                    sizes: '(min-width: 750px) 200px, 33vw',
                    class: 'fgo__img',
                    alt: img_alt
                }}
              {%- else -%}
                {{ placeholder_name | placeholder_svg_tag: 'fgo__img' }}
              {%- endif -%}
            </div>
          </div>
        </div>
        {%- if card_title != blank -%}
          <p class="fgo__title">{{ card_title | escape }}</p>
        {%- endif -%}
      </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>
