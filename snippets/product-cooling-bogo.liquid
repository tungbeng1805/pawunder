{%- doc -%}
  Buy 1 Get 1 promo line shown under the product price.
{%- enddoc -%}

<div class="cooling-bogo">
  <span class="cooling-bogo__icon" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none">
      <path d="M12 7.2c.8-2.2 3-3.4 5-2.6 1.5.6 2.3 2.2 2.1 3.7-.3 2.2-2.6 3.5-5 4.7-2.4-1.2-4.7-2.5-5-4.7-.2-1.5.6-3.1 2.1-3.7 2-.8 4.2.4 5 2.6Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M4.8 10.8h14.4v8.4a1.6 1.6 0 0 1-1.6 1.6H6.4a1.6 1.6 0 0 1-1.6-1.6v-8.4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <path d="M12 10.8v10M4.8 14.2h14.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>
  </span>
  <span class="cooling-bogo__copy">
    <strong>Buy 1 Get 1 Free</strong>
    <span>Buy 1, a free product is automatically added to your cart</span>
  </span>
</div>

{% stylesheet %}
  .cooling-bogo {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    margin-top: 10px;
    padding: 10px 12px;
    border-radius: 10px;
    background: linear-gradient(90deg, #ecfdf5 0%, #d1fae5 100%);
    border: 1.5px solid #6ee7b7;
  }

  .cooling-bogo__icon {
    flex: 0 0 34px;
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #059669;
    color: #fff;
  }

  .cooling-bogo__icon svg {
    width: 18px;
    height: 18px;
  }

  .cooling-bogo__copy {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .cooling-bogo__copy strong {
    font-size: 0.9375rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    color: #065f46;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .cooling-bogo__copy span {
    font-size: 0.75rem;
    line-height: 1.35;
    color: #047857;
  }
{% endstylesheet %}
