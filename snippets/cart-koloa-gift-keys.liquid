{%- comment -%}
  Outputs comma-separated line-item keys for gifts added by Gift offer popup.
  Only gift lines have the private line-item property "FREE GIFT"; the main
  product is intentionally left unmarked and continues to render normally.
{%- endcomment -%}
{%- for item in cart.items -%}
  {%- liquid
    assign is_koloa_gift = false
    assign free_gift_key = item.properties['FREE GIFT']
    if free_gift_key != blank
      assign is_koloa_gift = true
    endif
  -%}
  {%- if is_koloa_gift -%}{{ item.key }},{%- endif -%}
{%- endfor -%}
