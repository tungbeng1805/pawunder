{%- doc -%}
  Highlighted product benefits for the cooling mat product page.
{%- enddoc -%}

<div class="cooling-highlights">
  <ul class="cooling-highlights__list">
    <li class="cooling-highlights__item">
      <span class="cooling-highlights__icon" aria-hidden="true">❄️</span>
      <span class="cooling-highlights__copy">
        <strong>Instant Heat Relief</strong>
        <span>Prevents overheating and heatstroke during scorching summers</span>
      </span>
    </li>
    <li class="cooling-highlights__item">
      <span class="cooling-highlights__icon" aria-hidden="true">🧊</span>
      <span class="cooling-highlights__copy">
        <strong>Self-Cooling Technology</strong>
        <span>Automatically keeps pets cool without water or refrigeration</span>
      </span>
    </li>
    <li class="cooling-highlights__item">
      <span class="cooling-highlights__icon" aria-hidden="true">🐾</span>
      <span class="cooling-highlights__copy">
        <strong>100% Chew-Safe</strong>
        <span>No toxic gels or wires. Pure physical cooling fabric</span>
      </span>
    </li>
    <li class="cooling-highlights__item">
      <span class="cooling-highlights__icon" aria-hidden="true">🚗</span>
      <span class="cooling-highlights__copy">
        <strong>Grab-and-Go Design</strong>
        <span>Lightweight and foldable for cars, crates, and travel</span>
      </span>
    </li>
  </ul>
</div>

{% stylesheet %}
  .cooling-highlights {
    width: 100%;
    padding: 14px 16px;
    border-radius: 14px;
    background: linear-gradient(180deg, #f3fbff 0%, #e7f6fb 100%);
    border: 1.5px solid #bfe4ee;
    box-shadow: 0 8px 22px rgb(47 153 141 / 10%);
  }

  .cooling-highlights__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cooling-highlights__item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .cooling-highlights__icon {
    flex: 0 0 36px;
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 1px 4px rgb(15 23 42 / 8%);
    font-size: 1.05rem;
    line-height: 1;
  }

  .cooling-highlights__copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .cooling-highlights__copy strong {
    font-size: 0.9375rem;
    font-weight: 700;
    color: #12343f;
    line-height: 1.3;
  }

  .cooling-highlights__copy span {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: #4b6470;
  }

  @media screen and (min-width: 750px) {
    .cooling-highlights {
      padding: 16px 18px;
    }

    .cooling-highlights__list {
      grid-template-columns: 1fr 1fr;
      gap: 14px 16px;
    }
  }
{% endstylesheet %}
