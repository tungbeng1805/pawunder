054\/files\/intransit-icon.png?v=1775620337\",\n      iconDelivery: \"https:\/\/cdn.shopify.com\/s\/files\/1\/0659\/7217\/5054\/files\/delivered-icon.png?v=1775620337\"\n    };\n  <\/script>\n\n  <div class=\"shipping-timeline-v3\">\n    <div class=\"tm-header-v3\">\n      <img id=\"tm-main-icon\" src=\"\" class=\"tm-truck-icon-v3\" alt=\"shipping\"> \n      <span>Expected Delivery: <span id=\"tm-delivery-range-v3\" class=\"tm-bold-v3\">...<\/span><\/span>\n    <\/div>\n\n    <div class=\"tm-steps-wrapper-v3\">\n      <div class=\"tm-step-v3\">\n        <div class=\"tm-icon-box-v3\"><img id=\"tm-img-v3-1\" src=\"\" alt=\"order\"><\/div>\n        <div class=\"tm-date-v3\" id=\"tm-order-date-v3\">...<\/div>\n        <div class=\"tm-label-v3\">Order placed<\/div>\n      <\/div>\n      \n      <div class=\"tm-line-v3\"><\/div>\n\n      <div class=\"tm-step-v3\">\n        <div class=\"tm-icon-box-v3\"><img id=\"tm-img-v3-2\" src=\"\" alt=\"ship\"><\/div>\n        <div class=\"tm-date-v3\" id=\"tm-ship-date-v3\">...<\/div>\n        <div class=\"tm-label-v3\">Order ships<\/div>\n      <\/div>\n\n      <div class=\"tm-line-v3\"><\/div>\n\n      <div class=\"tm-step-v3\">\n        <div class=\"tm-icon-box-v3\"><img id=\"tm-img-v3-3\" src=\"\" alt=\"delivery\"><\/div>\n        <div class=\"tm-date-v3\" id=\"tm-delivery-date-v3\">...<\/div>\n        <div class=\"tm-label-v3\">Delivered!<\/div>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/div>\n\n<style>\n  \/* Cố định khung chứa để không bị chèn lấp *\/\n  .shipping-wrapper-fixed {\n    display: block;\n    clear: both;\n    width: 100%;\n    margin: 20px 0;\n    padding: 0;\n    overflow: hidden; \/* Ngăn các thành phần con tràn ra ngoài *\/\n  }\n\n  .shipping-timeline-v3 {\n    background: #fdfdfd;\n    padding: 15px;\n    border-radius: 4px;\n  }\n\n  .tm-header-v3 {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    font-size: 16px;\n    margin-bottom: 25px;\n    color: #111;\n  }\n\n  .tm-truck-icon-v3 { \n    width: 28px; \/* Đã fix size icon header *\/\n    height: auto; \n  }\n\n  .tm-bold-v3 { font-weight: 700; }\n\n  .tm-steps-wrapper-v3 {\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    width: 100%;\n    max-width: 100%;\n  }\n\n  .tm-step-v3 {\n    flex: 0 0 80px; \/* Cố định độ rộng từng bước để không bị xô lệch *\/\n    text-align: center;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n  }\n\n  .tm-icon-box-v3 {\n    width: 40px;\n    height: 40px;\n    background: #f0faff; \n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin-bottom: 8px;\n  }\n\n  .tm-icon-box-v3 img {\n    width: 22px; \/* Đã fix size 3 icon dưới *\/\n    height: 22px;\n    object-fit: contain;\n  }\n\n  .tm-line-v3 {\n    flex: 1;\n    height: 1px;\n    border-top: 2px dotted #a8d5db;\n    margin-top: 20px; \/* Căn chỉnh đường kẻ giữa các icon *\/\n  }\n\n  .tm-date-v3 {\n    font-weight: 700;\n    font-size: 13px;\n    margin-top: 5px;\n    white-space: nowrap;\n  }\n\n  .tm-label-v3 {\n    font-size: 11px;\n    color: #666;\n    margin-top: 2px;\n    line-height: 1.2;\n  }\n\n  @media (max-width: 480px) {\n    .tm-header-v3 { font-size: 14px; }\n    .tm-step-v3 { flex: 0 0 70px; }\n    .tm-date-v3 { font-size: 11px; }\n    .tm-icon-box-v3 { width: 35px; height: 35px; }\n  }\n<\/style>\n\n<script>\n  (function() {\n    const config = shippingConfig;\n    const months = [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"];\n    \n    function formatDay(date) {\n      return months[date.getMonth()] + \" \" + String(date.getDate()).padStart(2, '0');\n    }\n\n    function getRange(startDays, endDays) {\n      const d1 = new Date();\n      d1.setDate(d1.getDate() + startDays);\n      const d2 = new Date();\n      d2.setDate(d2.getDate() + endDays);\n      if (d1.getMonth() === d2.getMonth()) {\n        return months[d1.getMonth()] + \" \" + String(d1.getDate()).padStart(2, '0') + \"-\" + String(d2.getDate()).padStart(2, '0');\n      } else {\n        return months[d1.getMonth()] + \" \" + d1.getDate() + \" - \" + months[d2.getMonth()] + \" \" + d2.getDate();\n      }\n    }\n\n    const today = new Date();\n    \/\/ Gán Icons\n    if(config.iconHeader) document.getElementById('tm-main-icon').src = config.iconHeader;\n    if(config.iconOrder) document.getElementById('tm-img-v3-1').src = config.iconOrder;\n    if(config.iconShip) document.getElementById('tm-img-v3-2').src = config.iconShip;\n    if(config.iconDelivery) document.getElementById('tm-img-v3-3').src = config.iconDelivery;\n\n    \/\/ Gán Dates\n    document.getElementById('tm-order-date-v3').innerText = formatDay(today);\n    document.getElementById('tm-ship-date-v3').innerText = getRange(config.shipAfterMin, config.shipAfterMax);\n    const delTxt = getRange(config.deliveryMin, config.deliveryMax);\n    document.getElementById('tm-delivery-date-v3').innerText = delTxt;\n    document.getElementById('tm-delivery-range-v3').innerText = delTxt;\n  })();\n<\/script>"},"blocks":{}},"custom_liquid_tXyULh":{"type":"custom-liquid","name":"Free shipping bar","settings":{"custom_liquid":"<div style=\"text-align: center; background-color: #f0fdf4; color: #166534; padding: 8px; border-radius: 4px; font-weight: bold; margin: 10px 0; border: 1px solid #bbf7d0; font-size: 14px;\">\n  🚚 Your order qualifies for FREE SHIPPING!\n<\/div>"},"blocks":{}},"vitals_ub_product_bundles_E96Y4E":{"type":"shopify:\/\/apps\/vitals\/blocks\/ub-product-bundles\/aeb48102-2a5a-4f39-bdbd-d8d49f4e20b8","settings":{}},"buy_buttons_eYQEYi":{"type":"buy-buttons","settings":{"stacking":true,"show_pickup_availability":false,"gift_card_form":true,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{"quantity":{"type":"quantity","static":true,"settings":{},"blocks":{}},"add-to-cart":{"type":"add-to-