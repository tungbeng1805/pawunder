75620337\",\n      iconDelivery: \"https:\/\/cdn.shopify.com\/s\/files\/1\/0659\/7217\/5054\/files\/delivered-icon.png?v=1775620337\"\n    };\n  <\/script>\n\n  <div class=\"shipping-timeline-v3\">\n    <div class=\"tm-header-v3\">\n      <img id=\"tm-main-icon\" src=\"\" class=\"tm-truck-icon-v3\" alt=\"shipping\"> \n      <span>Expected Delivery: <span id=\"tm-delivery-range-v3\" class=\"tm-bold-v3\">...<\/span><\/span>\n    <\/div>\n\n    <div class=\"tm-steps-wrapper-v3\">\n      <div class=\"tm-step-v3\">\n        <div class=\"tm-icon-box-v3\"><img id=\"tm-img-v3-1\" src=\"\" alt=\"order\"><\/div>\n        <div class=\"tm-date-v3\" id=\"tm-order-date-v3\">...<\/div>\n        <div class=\"tm-label-v3\">Order placed<\/div>\n      <\/div>\n      \n      <div class=\"tm-line-v3\"><\/div>\n\n      <div class=\"tm-step-v3\">\n        <div class=\"tm-icon-box-v3\"><img id=\"tm-img-v3-2\" src=\"\" alt=\"ship\"><\/div>\n        <div class=\"tm-date-v3\" id=\"tm-ship-date-v3\">...<\/div>\n        <div class=\"tm-label-v3\">Order ships<\/div>\n      <\/div>\n\n      <div class=\"tm-line-v3\"><\/div>\n\n      <div class=\"tm-step-v3\">\n        <div class=\"tm-icon-box-v3\"><img id=\"tm-img-v3-3\" src=\"\" alt=\"delivery\"><\/div>\n        <div class=\"tm-date-v3\" id=\"tm-delivery-date-v3\">...<\/div>\n        <div class=\"tm-label-v3\">Delivered!<\/div>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/div>\n\n<style>\n  \/* Cố định khung chứa để không bị chèn lấp *\/\n  .shipping-wrapper-fixed {\n    display: block;\n    clear: both;\n    width: 100%;\n    margin: 20px 0;\n    padding: 0;\n    overflow: hidden; \/* Ngăn các thành phần con tràn ra ngoài *\/\n  }\n\n  .shipping-timeline-v3 {\n    background: #fdfdfd;\n    padding: 15px;\n    border-radius: 4px;\n  }\n\n  .tm-header-v3 {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    font-size: 16px;\n    margin-bottom: 25px;\n    color: #111;\n  }\n\n  .tm-truck-icon-v3 { \n    width: 28px; \/* Đã fix size icon header *\/\n    height: auto; \n  }\n\n  .tm-bold-v3 { font-weight: 700; }\n\n  .tm-steps-wrapper-v3 {\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    width: 100%;\n    max-width: 100%;\n  }\n\n  .tm-step-v3 {\n    flex: 0 0 80px; \/* Cố định độ rộng từng bước để không bị xô lệch *\/\n    text-align: center;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n  }\n\n  .tm-icon-box-v3 {\n    width: 40px;\n    height: 40px;\n    background: #f0faff; \n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin-bottom: 8px;\n  }\n\n  .tm-icon-box-v3 img {\n    width: 22px; \/* Đã fix size 3 icon dưới *\/\n    height: 22px;\n    object-fit: contain;\n  }\n\n  .tm-line-v3 {\n    flex: 1;\n    height: 1px;\n    border-top: 2px dotted #a8d5db;\n    margin-top: 20px; \/* Căn chỉnh đường kẻ giữa các icon *\/\n  }\n\n  .tm-date-v3 {\n    font-weight: 700;\n    font-size: 13px;\n    margin-top: 5px;\n    white-space: nowrap;\n  }\n\n  .tm-label-v3 {\n    font-size: 11px;\n    color: #666;\n    margin-top: 2px;\n    line-height: 1.2;\n  }\n\n  @media (max-width: 480px) {\n    .tm-header-v3 { font-size: 14px; }\n    .tm-step-v3 { flex: 0 0 70px; }\n    .tm-date-v3 { font-size: 11px; }\n    .tm-icon-box-v3 { width: 35px; height: 35px; }\n  }\n<\/style>\n\n<script>\n  (function() {\n    const config = shippingConfig;\n    const months = [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"];\n    \n    function formatDay(date) {\n      return months[date.getMonth()] + \" \" + String(date.getDate()).padStart(2, '0');\n    }\n\n    function getRange(startDays, endDays) {\n      const d1 = new Date();\n      d1.setDate(d1.getDate() + startDays);\n      const d2 = new Date();\n      d2.setDate(d2.getDate() + endDays);\n      if (d1.getMonth() === d2.getMonth()) {\n        return months[d1.getMonth()] + \" \" + String(d1.getDate()).padStart(2, '0') + \"-\" + String(d2.getDate()).padStart(2, '0');\n      } else {\n        return months[d1.getMonth()] + \" \" + d1.getDate() + \" - \" + months[d2.getMonth()] + \" \" + d2.getDate();\n      }\n    }\n\n    const today = new Date();\n    \/\/ Gán Icons\n    if(config.iconHeader) document.getElementById('tm-main-icon').src = config.iconHeader;\n    if(config.iconOrder) document.getElementById('tm-img-v3-1').src = config.iconOrder;\n    if(config.iconShip) document.getElementById('tm-img-v3-2').src = config.iconShip;\n    if(config.iconDelivery) document.getElementById('tm-img-v3-3').src = config.iconDelivery;\n\n    \/\/ Gán Dates\n    document.getElementById('tm-order-date-v3').innerText = formatDay(today);\n    document.getElementById('tm-ship-date-v3').innerText = getRange(config.shipAfterMin, config.shipAfterMax);\n    const delTxt = getRange(config.deliveryMin, config.deliveryMax);\n    document.getElementById('tm-delivery-date-v3').innerText = delTxt;\n    document.getElementById('tm-delivery-range-v3').innerText = delTxt;\n  })();\n<\/script>"},"blocks":{}},"custom_liquid_9kdVgJ":{"type":"custom-liquid","name":"upload photo","settings":{"custom_liquid":"{% if product.metafields.custom.allow_upload == true %}\n<div class=\"product-custom-upload\" style=\"margin: 15px 0 25px 0;\">\n  <label for=\"pet-photo\" style=\"display: block; font-weight: bold; margin-bottom: 10px; font-size: 14px; color: #333;\">\n    🐾 Upload your pet's photo (Required):\n  <\/label>\n  \n  <div style=\"position: relative;\">\n    <input \n      type=\"file\" \n      id=\"pet-photo\" \n      name=\"properties[Pet Photo]\" \n      accept=\"image\/*\"\n      required \n      form=\"product-form-{{ section.id }}\"\n      onchange=\"checkFile(this)\"\n      style=\"display: block; width: 100%; border: 2px dashed #ff8a00; padding: 15px; border-radius: 8px; background: #fffaf5; cursor: pointer;\"\n    >\n  <\/div>\n  \n  <p id=\"upload-error\" style=\"display: none; color: #d93025; font-size: 12px; margin-top: 8px; font-weight: bold;\">\n    ⚠️ Please upload a photo before adding to cart!\n  <\/p>\n  \n  <p style=\"font-size: 11px; color: #666; margin-top: 8px;\">\n    * Accept 1 photo (JPG, PNG). High resolution recommended.\n  <\/p>\n<\/div>\n\n<script>\n  function checkFile(input) {\n    const errorMsg = document.getElementById('upload-error');\n    if (input.files.length > 0) {\n      errorMsg.style.display = 'none';\n      input.style.borderColor = '#4CAF50'; \/\/ Đổi sang màu xanh khi đã up ảnh\n    }\n  }\n\n  \/\/ Chặn nút Add to Cart nếu chưa có file\n  document.addEventListener('DOMContentLoaded', function() {\n    const productForm = document.querySelector('#product-form-{{ section.id }}');\n    if (productForm) {\n      productForm.addEventListener('submit', function(e) {\n        const fileInput = document.getElementById('pet-photo');\n        const errorMsg = document.getElementById('upload-error');\n        \n        if (!fileInput.files || fileInput.files.length === 0) {\n          e.preventDefault(); \/\/ Chặn hành động add to cart\n          e.stopImmediatePropagation();\n          errorMsg.style.display = 'block';\n          fileInput.scrollIntoView({ behavior: 'smooth', block: 'center' });\n          return false;\n        }\n      }, true);\n    }\n  });\n<\/script>\n\n<style>\n  \/* Hiệu ứng khi di chuột vào ô upload *\/\n  .product-custom-upload input[type=\"file\"]:hover {\n    background-color: #fff4e6 !important;\n    border-style: solid !important;\n  }\n<\/style>\n{% endif %}"},"blocks":{}},"ai_gen_block_8303218_XkC7NH":{"type":"ai_gen_block_8303218","disabled":true,"settings":{"heading":"Upload your pet's photo","description":"","upload_label":"Click to upload or drag and drop","upload_hint":"PNG, JPG up to 20MB","max_files":5,"max_file_size":5,"desktop_width_percent":100,"padding":24,"border_radius":14,"dropzone_border_radius":8,"background_color":"#ffffff","text_color":"#000000","dropzo