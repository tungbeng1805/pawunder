Date();\n    \/\/ Gán Icons\n    if(config.iconHeader) document.getElementById('tm-main-icon').src = config.iconHeader;\n    if(config.iconOrder) document.getElementById('tm-img-v3-1').src = config.iconOrder;\n    if(config.iconShip) document.getElementById('tm-img-v3-2').src = config.iconShip;\n    if(config.iconDelivery) document.getElementById('tm-img-v3-3').src = config.iconDelivery;\n\n    \/\/ Gán Dates\n    document.getElementById('tm-order-date-v3').innerText = formatDay(today);\n    document.getElementById('tm-ship-date-v3').innerText = getRange(config.shipAfterMin, config.shipAfterMax);\n    const delTxt = getRange(config.deliveryMin, config.deliveryMax);\n    document.getElementById('tm-delivery-date-v3').innerText = delTxt;\n    document.getElementById('tm-delivery-range-v3').innerText = delTxt;\n  })();\n<\/script>"},"blocks":{}},"custom_liquid_tXyULh":{"type":"custom-liquid","name":"Free shipping bar","settings":{"custom_liquid":"<div style=\"text-align: center; background-color: #f0fdf4; color: #166534; padding: 8px; border-radius: 4px; font-weight: bold; margin: 10px 0; border: 1px solid #bbf7d0; font-size: 14px;\">\n  🚚 Your order qualifies for FREE SHIPPING!\n<\/div>"},"blocks":{}},"vitals_ub_product_bundles_E96Y4E":{"type":"shopify:\/\/apps\/vitals\/blocks\/ub-product-bundles\/aeb48102-2a5a-4f39-bdbd-d8d49f4e20b8","settings":{}},"buy_buttons_eYQEYi":{"type":"buy-buttons","settings":{"stacking":true,"show_pickup_availability":false,"gift_card_form":true,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{"quantity":{"type":"quantity","static":true,"settings":{},"blocks":{}},"add-to-cart":{"type":"add-to-cart","static":true,"settings":{"style_class":"button"},"blocks":{}},"accelerated-checkout":{"type":"accelerated-checkout","static":true,"settings":{},"blocks":{}}},"block_order":[]},"text_aEtTtq":{"type":"text","name":"Product description","disabled":true,"settings":{"text":"{{ closest.product.de