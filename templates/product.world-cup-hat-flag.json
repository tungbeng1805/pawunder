 2px solid #fff;\n  }\n\n  \/* Hiệu ứng hiện ra mượt mà *\/\n  @keyframes fadeIn {\n    from { opacity: 0; transform: translateY(-20px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n<\/style>\n\n<script>\n  function openSizeModal() {\n    document.getElementById(\"sizeGuideModal\").style.display = \"block\";\n    document.body.style.overflow = \"hidden\"; \/* Khóa cuộn trang khi mở popup *\/\n  }\n\n  function closeSizeModal() {\n    document.getElementById(\"sizeGuideModal\").style.display = \"none\";\n    document.body.style.overflow = \"auto\"; \/* Mở lại cuộn trang *\/\n  }\n\n  \/\/ Đóng khi bấm ra ngoài vùng ảnh\n  window.onclick = function(event) {\n    var modal = document.getElementById(\"sizeGuideModal\");\n    if (event.target == modal) {\n      closeSizeModal();\n    }\n  }\n<\/script>"},"blocks":{}},"divider_dEA3HV":{"type":"_divider","name":"t:names.divider","disabled":true,"settings":{"thickness":1,"corner_radius":"square","width_percent":100,"padding-block-start":0,"padding-block-end":0},"blocks":{}},"custom_liquid_cW4dFN":{"type":"custom-liquid","name":"Estimate Delivery Time","settings":{"custom_liquid":"<div class=\"shipping-wrapper-fixed\">\n  \n  <script>\n    const shippingConfig = {\n      deliveryMin: 5,   \n      deliveryMax: 7,\n      shipAfterMin: 1,\n      shipAfterMax: 2,\n      \/\/ Dán link icon của bạn vào đây\n      iconHeader: \"https:\/\/cdn.shopify.com\/s\/files\/1\/0659\/7217\/5054\/files\/intransit-icon-header.png?v=1775634225\", \n      iconOrder: \"https:\/\/cdn.shopify.com\/s\/files\/1\/0659\/7217\/5054\/files\/placed-order-icon.png?v=1775620337\", \n      iconShip: \"https:\/\/cdn.shopify.com\/s\/files\/1\/0659\/7217\/5054\/files\/intransit-icon.png?v=1775620337\",\n      iconDelivery: \"https:\/\/cdn.shopify.com\/s\/files\/1\/0659\/7217\/5054\/files\/delivered-icon.png?v=1775620337\"\n    };\n  <\/script>\n\n  <div class=\"shipping-timeline-v3\">\n    <div class=\"tm-header-v3\">\n      <img id=\"tm-main-icon\"