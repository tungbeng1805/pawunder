    "custom_liquid_3P8y98": {
      "type": "custom-liquid",
      "name": "Testimonial",
      "settings": {
        "custom_liquid": "<div class=\"testimonial-section\">\n  <div class=\"tm-slider-container\" id=\"tmSliderContainer\">\n    <div class=\"tm-wrapper\">\n      <div class=\"testimonial-card is-selected\">\n        <div class=\"tm-stars\">★★★★★</div>\n        <p class=\"tm-content\">I ordered a custom canvas of my dog and it turned out even better than I imagined. The details were amazing and it looks perfect in my living room!</p>\n        <div class=\"tm-author-img\"><img src=\"https://cdn.shopify.com/s/files/1/0659/7217/5054/files/pet-parents-icon.png?v=1775709040\" alt=\"User\"></div>\n        <h4 class=\"tm-name\">Tracy</h4>\n        <p class=\"tm-date\">on Mar 3, 2026</p>\n      </div>\n      <div class=\"testimonial-card\">\n        <div class=\"tm-stars\">★★★★★</div>\n        <p class=\"tm-content\">My cat is obsessed with the toys from PawUnder. She usually gets bored quickly, but these keep her entertained for hours</p>\n        <div class=\"tm-author-img\"><img src=\"https://cdn.shopify.com/s/files/1/0659/7217/5054/files/pet-parents-icon.png?v=1775709040\" alt=\"User\"></div>\n        <h4 class=\"tm-name\">Cara</h4>\n        <p class=\"tm-date\">on Mar 8, 2026</p>\n      </div>\n      <div class=\"testimonial-card\">\n        <div class=\"tm-stars\">★★★★★</div>\n        <p class=\"tm-content\">The pet care products are great quality and arrived so quickly. I love finding everything my pup needs in one place.</p>\n        <div class=\"tm-author-img\"><img src=\"https://cdn.shopify.com/s/files/1/0659/7217/5054/files/pet-parents-icon.png?v=1775709040\" alt=\"User\"></div>\n        <h4 class=\"tm-name\">Anna & Mike</h4>\n        <p class=\"tm-date\">on Mar 10, 2026</p>\n      </div>\n      <div class=\"testimonial-card\">\n        <div class=\"tm-stars\">★★★★★</div>\n        <p class=\"tm-content\">I bought a personalized gift for my friend’s dog and she absolutely loved it. Such a thoughtful and unique idea for pet lovers!</p>\n        <div class=\"tm-author-img\"><img src=\"https://cdn.shopify.com/s/files/1/0659/7217/5054/files/pet-parents-icon.png?v=1775709040\" alt=\"User\"></div>\n        <h4 class=\"tm-name\">John D.</h4>\n        <p class=\"tm-date\">on Mar 12, 2026</p>\n      </div>\n      <div class=\"testimonial-card\">\n        <div class=\"tm-stars\">★★★★★</div>\n        <p class=\"tm-content\">Shipping was incredibly fast and the packaging was very secure. Highly recommend this shop!</p>\n        <div class=\"tm-author-img\"><img src=\"https://cdn.shopify.com/s/files/1/0659/7217/5054/files/pet-parents-icon.png?v=1775709040\" alt=\"User\"></div>\n        <h4 class=\"tm-name\">Sarah L.</h4>\n        <p class=\"tm-date\">on Mar 15, 2026</p>\n      </div>\n      <div class=\"testimonial-card\">\n        <div class=\"tm-stars\">★★★★★</div>\n        <p class=\"tm-content\">Shopping at this shop was so easy and fun. There are so many cute things for pets, and the customer service was amazing too.</p>\n        <div class=\"tm-author-img\"><img src=\"https://cdn.shopify.com/s/files/1/0659/7217/5054/files/pet-parents-icon.png?v=1775709040\" alt=\"User\"></div>\n        <h4 class=\"tm-name\">David K.</h4>\n        <p class=\"tm-date\">on Mar 20, 2026</p>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"tm-dots\">\n    <span class=\"dot active\" onclick=\"scrollToSlide(0)\"></span>\n    <span class=\"dot\" onclick=\"scrollToSlide(1)\"></span>\n    <span class=\"dot\" onclick=\"scrollToSlide(2)\"></span>\n    <span class=\"dot\" onclick=\"scrollToSlide(3)\"></span>\n    <span class=\"dot\" onclick=\"scrollToSlide(4)\"></span>\n    <span class=\"dot\" onclick=\"scrollToSlide(5)\"></span>\n  </div>\n</div>\n<style>\n  .testimonial-section { background: #f9f9f9; padding: 50px 0; overflow: hidden; }\n  \n  .tm-slider-container { \n    display: flex;\n    overflow-x: scroll; /* Quan trọng: Cho phép cuộn ngang */\n    scroll-snap-type: x mandatory; /* Quan trọng: Vuốt là tự nhảy vào giữa thẻ */\n    scroll-behavior: smooth;\n    -webkit-overflow-scrolling: touch; /* Hỗ trợ vuốt mượt trên iOS */\n    scrollbar-width: none; /* Ẩn thanh cuộn trên Firefox */\n    padding-bottom: 30px;\n  }\n  \n  .tm-slider-container::-webkit-scrollbar { display: none; } /* Ẩn thanh cuộn trên Chrome/Safari */\n\n  .tm-wrapper { \n    display: flex; \n    padding: 0 15%; /* Tạo khoảng trống để thẻ đầu tiên nằm giữa */\n  }\n\n  .testimonial-card {\n    flex: 0 0 320px; /* Cố định độ rộng thẻ */\n    margin: 0 15px;\n    scroll-snap-align: center; /* Khi vuốt, thẻ này sẽ hít vào giữa màn hình */\n    background: #fff;\n    padding: 30px;\n    border-radius: 8px;\n    box-shadow: 0 10px 25px rgba(0,0,0,0.05);\n    opacity: 0.6;\n    transform: scale(0.9);\n    transition: all 0.3s ease;\n  }\n\n  /* Thẻ đang nằm giữa sẽ sáng lên */\n  .testimonial-card.is-selected { opacity: 1; transform: scale(1); box-shadow: 0 15px 35px rgba(0,0,0,0.1); }\n\n  .tm-stars { color: #000; font-size: 16px; margin-bottom: 15px; text-align: center; }\n  .tm-content { font-size: 14px; line-height: 1.6; color: #444; text-align: center; min-height: 80px; }\n  .tm-author-img { width: 60px; height: 60px; margin: 15px auto; border-radius: 50%; overflow: hidden; border: 2px solid #fff; }\n  .tm-author-img img { width: 100%; height: 100%; object-fit: cover; }\n  .tm-name { text-align: center; font-weight: bold; margin: 0; font-size: 15px; }\n  .tm-date { text-align: center; font-size: 12px; color: #999; }\n\n  .tm-dots { display: flex; justify-content: center; gap: 10px; margin-top: 10px; }\n  .dot { width: 8px; height: 8px; background: #ccc; border-radius: 50%; cursor: pointer; transition: 0.3s; }\n  .dot.active { background: #ff7b31; transform: scale(1.3); }\n\n  @media (max-width: 768px) {\n    .testimonial-card { flex: 0 0 280px; }\n    .tm-wrapper { padding: 0 10%; }\n  }\n</style>\n<script>\n  const container = document.getElementById('tmSliderContainer');\n  const cards = document.querySelectorAll('.testimonial-card');\n  const dots = document.querySelectorAll('.dot');\n\n  // Hàm khi nhấn vào dấu chấm\n  function scrollToSlide(index) {\n    const cardWidth = cards[0].offsetWidth + 30; // 30 là gap (margin 15px * 2)\n    container.scrollTo({\n      left: index * cardWidth,\n      behavior: 'smooth'\n    });\n  }\n\n  // Cập nhật trạng thái khi vuốt tay hoặc nhấn nút\n  container.addEventListener('scroll', () => {\n    const cardWidth = cards[0].offsetWidth + 30;\n    const index = Math.round(container.scrollLeft / cardWidth);\n\n    dots.forEach((dot, i) => {\n      dot.classList.toggle('active', i === index);\n    });\n\n    cards.forEach((card, i) => {\n      card.classList.toggle('is-selected', i === index);\n    });\n  });\n</script>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
  },
