    "1780893143f6d1c745": {
      "type": "_blocks",
      "blocks": {
        "custom_liquid_cHg7gP": {
          "type": "custom-liquid",
          "name": "t:names.custom_liquid",
          "settings": {
            "custom_liquid": "{% comment %}\n  ========================================================================\n  CUSTOM LIQUID SECTION: FORCE LARGE TEXT ON WEB\n  ========================================================================\n{% endcomment %}\n\n{% comment %} --- KHU VỰC CẤU HÌNH --- {% endcomment %}\n{% assign image_url = \"https://cdn.shopify.com/s/files/1/0659/7217/5054/files/custom-pet-pillow-personalized-dog-cat-pillow-005.webp?v=1780720138\" %}\n{% assign button_url = \"https://pawunder.com/products/custom-pet-pillow-personalized-dog-cat-pillow\" %}\n{% assign headline_color = \"#194950\" %}\n\n{% assign header_text = \"Custom Pet Pillow\" %}\n{% assign description_text = \"Capture the unforgettable moments of your furry friends!\" %}\n{% assign button_text = \"SHOP NOW\" %}\n{% comment %} ------------------------------------------------------ {% endcomment %}\n\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap');\n\n  /* ===================================================\n     MẶC ĐỊNH CHO WEB (CHỮ TO ĐẬM ĐỂ CÂN BẰNG VỚI ẢNH)\n     =================================================== */\n  #CustomPillowSection {\n    background-color: #ffffff;\n    padding: 60px 5%; /* Khoảng đệm rộng rãi trên Web */\n    width: 100%;\n    box-sizing: border-box;\n    font-family: 'Montserrat', -apple-system, sans-serif;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  #CustomPillowSection .section-grid {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 60px; /* Khoảng cách rộng giữa ảnh và chữ trên Web */\n    max-width: 1200px; \n    width: 100%;\n    margin: 0 auto;\n  }\n\n  #CustomPillowSection .col-image {\n    flex: 1;\n    text-align: center;\n    width: 50%;\n  }\n\n  #CustomPillowSection .product-image {\n    width: 100%;\n    height: auto;\n    display: block;\n    object-fit: cover; \n    border-radius: 12px;\n  }\n\n  #CustomPillowSection .col-content {\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: center; \n    text-align: center;    \n    width: 50%;\n    padding: 0 40px; \n    box-sizing: border-box;\n  }\n\n  /* ĐỊNH DẠNG TEXT TRÊN WEB: ÉP TO */\n  #CustomPillowSection .section-header {\n    font-size: 42px !important;  /* Ép cỡ chữ tiêu đề 42px siêu to */\n    font-weight: 700;\n    line-height: 1.2;\n    color: {{ headline_color }};\n    margin: 0 0 18px 0;\n  }\n\n  #CustomPillowSection .section-description {\n    font-size: 18px !important;  /* Ép cỡ chữ mô tả 18px rõ ràng */\n    line-height: 1.6;\n    color: #4a4a4a;\n    margin: 0 0 30px 0;\n    max-width: 450px;\n  }\n\n  #CustomPillowSection .shop-now-button {\n    display: inline-block;\n    background-color: #1a1a1a;\n    color: #ffffff;\n    text-decoration: none;\n    font-size: 15px !important; /* Nút lớn trên Web */\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 1.5px;\n    padding: 15px 45px;\n    border-radius: 6px;\n    border: none;\n    cursor: pointer;\n    transition: all 0.3s ease;\n    width: fit-content;\n    white-space: nowrap; \n  }\n\n  #CustomPillowSection .shop-now-button:hover {\n    background-color: {{ headline_color }};\n    transform: translateY(-2px);\n    box-shadow: 0 5px 15px rgba(0,0,0,0.1);\n  }\n\n  /* ===================================================\n     CHỈ DÀNH RIÊNG CHO MOBILE (THU NHỎ LẠI ĐỂ KHÔNG BỊ LỖI)\n     Kích hoạt khi màn hình nhỏ hơn 767px\n     =================================================== */\n  @media screen and (max-width: 767px) {\n    #CustomPillowSection {\n      padding: 20px 10px; \n    }\n\n    #CustomPillowSection .section-grid {\n      gap: 12px; \n    }\n\n    #CustomPillowSection .col-content {\n      padding: 0 5px; \n    }\n\n    /* Thu nhỏ chữ lại khi xem trên điện thoại */\n    #CustomPillowSection .section-header {\n      font-size: 18px !important; \n      margin-bottom: 6px;\n    }\n\n    #CustomPillowSection .section-description {\n      font-size: 14px !important; \n      line-height: 1.4;\n      margin-bottom: 14px;\n    }\n\n    #CustomPillowSection .shop-now-button {\n      font-size: 12px !important;\n      padding: 10px 18px;\n      border-radius: 4px;\n      letter-spacing: 0.5px;\n    }\n  }\n</style>\n\n<div id=\"CustomPillowSection\">\n  <div class=\"section-grid\">\n    \n    <div class=\"col-image\">\n      <img src=\"{{ image_url }}\" class=\"product-image\" alt=\"Custom Pet Pillow - Personalized Dog/Cat Pillow\">\n    </div>\n\n    <div class=\"col-content\">\n      <h2 class=\"section-header\">{{ header_text }}</h2>\n      <p class=\"section-description\">{{ description_text }}</p>\n      \n      <a href=\"{{ button_url }}\" class=\"shop-now-button\">\n        {{ button_text }}\n      </a>\n    </div>\n\n  </div>\n</div>"
